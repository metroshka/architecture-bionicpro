        <mxCell id="r-subtitle" value="Один независимый серверный контур на страну обслуживания · схема размещения" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=19;fontColor=#64748B;fontStyle=0;fillColor=none;strokeColor=none;rounded=1;arcSize=8;">
