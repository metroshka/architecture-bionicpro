          </mxGeometry>
        </mxCell>
        <mxCell id="publication-rule" value="&lt;b&gt;Правило публикации&lt;/b&gt;&lt;br&gt;API читает только версию, указанную в реестре готовых периодов. Промежуточные и частично записанные данные не публикуются. Готовность сохраняется и для успешно обработанного дня без событий. Повторный запуск не увеличивает итоги повторно; исправление периода создаёт новую версию." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=18;fontColor=#19334C;fontStyle=0;fillColor=#F0E9F8;strokeColor=none;rounded=1;arcSize=8;">
          <mxGeometry x="80" y="670" width="2270" height="125" as="geometry" />
        </mxCell>
        <object id="api-lane" label="&lt;b&gt;2. Получение отчёта — API /reports читает готовую витрину&lt;/b&gt;">
