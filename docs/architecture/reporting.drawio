        <mxCell id="bff-api" value="Запрос и ответ /reports&lt;br&gt;access token на сервере" edge="1" parent="1" source="bff" target="Lhtp9tOnbV0N8Cz71-gY-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;strokeColor=#15806E;strokeWidth=2;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=13;fontColor=#15806E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=block;startFill=1;">
          <mxGeometry x="0" relative="1" as="geometry">
