        <mxCell id="mobile-bff" value="HTTPS · сессия приложения" edge="1" parent="1" source="Lhtp9tOnbV0N8Cz71-gY-20" target="bff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;strokeColor=#7252A0;strokeWidth=2;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=13;fontColor=#7252A0;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;">
