          </mxCell>
        </object>
        <object id="request" c4Name="Запрос пользователя" c4Type="HTTPS" c4Technology="" c4Description="Период отчёта. Запрос не запускает расчёт в Airflow." label="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Запрос пользователя&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;[HTTPS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Период отчёта. Запрос не запускает расчёт в Airflow.&lt;/font&gt;">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1F6B99;strokeColor=#1F6B99;fontColor=#FFFFFF;fontFamily=Arial;align=center;verticalAlign=middle;fontSize=14;spacing=12;resizable=1;metaEdit=1;">
