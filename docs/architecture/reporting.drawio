          </mxGeometry>
        </mxCell>
        <mxCell id="bff-keycloak" value="OIDC Code + PKCE S256" edge="1" parent="1" source="bff" target="keycloak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;strokeColor=#15806E;strokeWidth=2;dashed=0;dashPattern=6 4;fontFamily=Arial;fontSize=13;fontColor=#15806E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry x="0" relative="1" as="geometry">
            <mxPoint x="220" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="api-jwks" value="JWKS · HTTPS&lt;br&gt;Ключи проверки подписи JWT" edge="1" parent="1" source="Lhtp9tOnbV0N8Cz71-gY-17" target="keycloak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;strokeColor=#15806E;strokeWidth=2;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=13;fontColor=#15806E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry x="0" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1865" y="1515" />
            </Array>
            <mxPoint x="0" y="24" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mart-note" value="&lt;b&gt;Витрина&lt;/b&gt;&lt;br&gt;Пользователь × протез × день.&lt;br&gt;Модель протеза из CRM.&lt;br&gt;Число зарегистрированных движений и среднее время реакции.&lt;br&gt;Ключ чтения: владелец, дата." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=16;fontColor=#19334C;fontStyle=0;fillColor=#FFF1E3;strokeColor=none;rounded=1;arcSize=8;">
          <mxGeometry x="2110" y="665" width="310" height="230" as="geometry" />
        </mxCell>
        <mxCell id="api-note" value="&lt;b&gt;Доступ и готовность&lt;/b&gt;&lt;br&gt;Владелец берётся из проверенных iss / sub, а не из параметра user_id.&lt;br&gt;&lt;br&gt;Нет готового периода ≠ готовый период без данных." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=16;fontColor=#19334C;fontStyle=0;fillColor=#EDF7F4;strokeColor=none;rounded=1;arcSize=8;">
          <mxGeometry x="2110" y="1180" width="310" height="210" as="geometry" />
        </mxCell>
        <mxCell id="source-note" value="&lt;b&gt;Границы схемы&lt;/b&gt;&lt;br&gt;Показан отчётный путь исходной C4; названия CRM, CRM DB, База данных и API сохранены. Приём телеметрии протезов, продажи и ML остаются в исходном контуре. Сервис отчётов реализует backend API /reports и не обращается к исходным БД во время выдачи отчёта." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=17;fontColor=#19334C;fontStyle=0;fillColor=#F0F5FA;strokeColor=none;rounded=1;arcSize=8;">
          <mxGeometry x="40" y="1660" width="1200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="auth-note" value="&lt;b&gt;Аутентификация и доступ&lt;/b&gt;&lt;br&gt;Keycloak аутентифицирует пользователя. BFF хранит токены IdP на сервере и передаёт запросы в API. API проверяет подпись, iss, aud, exp и права и выдаёт только данные владельца. Доступ API к ClickHouse — только на чтение; ETL использует отдельную роль записи." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=17;fontColor=#19334C;fontStyle=0;fillColor=#EDF7F4;strokeColor=none;rounded=1;arcSize=8;">
          <mxGeometry x="1280" y="1660" width="1200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;font color=&quot;#1F6B99&quot;&gt;■&lt;/font&gt; Исходные компоненты и приложение &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#7654A3&quot;&gt;■&lt;/font&gt; Подготовка данных &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#A86124&quot;&gt;■&lt;/font&gt; OLAP и выдача &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#167566&quot;&gt;■&lt;/font&gt; Контур входа" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=17;fontColor=#19334C;fontStyle=0;fillColor=none;strokeColor=none;rounded=1;arcSize=8;">
          <mxGeometry x="40" y="1860" width="2440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="model-note" value="Показатели и суточная детализация — выбор учебной модели. Полные схемы исходных таблиц в материалах не заданы. Витрина содержит только необходимые данные; исходные миосигналы в отчёт не копируются." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=16;fontColor=#64748B;fontStyle=0;fillColor=none;strokeColor=none;rounded=1;arcSize=8;">
          <mxGeometry x="40" y="1920" width="2440" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
